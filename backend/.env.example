APP_NAME="PEMDI PANRB"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Alamat reverse proxy/CDN yang dipercaya untuk membaca IP pengunjung (X-Forwarded-For), dipisah koma,
# atau * bila hanya proxy yang bisa menjangkau server. Kosong = tidak ada (Nginx + PHP-FPM langsung).
TRUSTED_PROXIES=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Sesi admin berakhir setelah 60 menit tanpa aktivitas.
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi (HTTPS): wajib true agar cookie sesi hanya dikirim lewat HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Kata sandi akun demo admin@pemdi.test dan penulis@pemdi.test (DemoUserSeeder; ditolak di produksi).
# Kosongkan untuk memakai bawaan seeder.
DEMO_USER_PASSWORD=

# Folder unggahan gambar CMS di storage/app/public (URL /storage/<folder>). Jalankan
# `php artisan storage:link` sekali. Uji e2e memakai media-e2e.
MEDIA_DIRECTORY=media

# Formulir kontak publik (config/pemdi.php): masa simpan pesan (bulan), batas pesan per IP per
# 10 menit, jeda minimum sejak formulir dibuka (detik), dan umur token formulir (menit).
CONTACT_RETENTION_MONTHS=12
CONTACT_RATE_LIMIT=5
CONTACT_MIN_SECONDS=3
CONTACT_TOKEN_TTL_MINUTES=120

# Batas permintaan API situs publik per IP per menit.
PUBLIC_API_RATE_LIMIT=120

# Masa simpan log aktivitas (bulan); memuat alamat IP sehingga tidak disimpan selamanya.
ACTIVITY_RETENTION_MONTHS=24
