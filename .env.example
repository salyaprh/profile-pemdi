# Salin menjadi .env.local lalu isi.
# PENTING: semua variabel VITE_* tertanam di bundle dan bersifat publik. Jangan isi secret.

# URL produksi tanpa path. Mengaktifkan canonical, og:url, dan sitemap.xml.
# Atur di environment build Production hosting (bukan untuk pratinjau/preview).
VITE_SITE_URL=

# Endpoint (POST JSON: name, email, phone, subject, message) penerima pesan dari halaman
# "Hubungi kami". Disarankan se-origin (mis. /api/contact) agar CSP connect-src 'self' cukup.
# Bila kosong, formulir memberi tahu bahwa pesan belum dikirim.
VITE_CONTACT_ENDPOINT=
