# Salin menjadi .env.local lalu isi.
# PENTING: semua variabel VITE_* tertanam di bundle dan bersifat publik. Jangan isi secret.

# URL produksi tanpa path. Mengaktifkan canonical, og:url, dan baris Sitemap di robots.txt.
# Atur di environment build Production hosting (bukan untuk pratinjau/preview).
VITE_SITE_URL=
